  {
   "type": "timeseries",
   "title": "State changes per second",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (entity, to) (rate(payments_transitions_total[1m]))",
     "legendFormat": "{{entity}} \u2192 {{to}}",
     "refId": "A",
     "exemplar": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 25,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "normal"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
